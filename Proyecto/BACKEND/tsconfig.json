{
  "compilerOptions": {
    
    "target": "es2020",                                 
    "module": "commonjs",                                
    "lib": ["es2020"],                                  

    "allowJs": true,                                     
    "checkJs": false,                                   

    
    "outDir": "./dist",                                  
    "rootDir": "./src",                                  
    "removeComments": true,                              
    "noEmit": false,                                     

    
    "strict": true,                                      
    "noImplicitAny": true,                               
    "strictNullChecks": true,                            

    
    "esModuleInterop": true,                            
    "forceConsistentCasingInFileNames": true,            

    
    "skipLibCheck": true                                 
  },
  "include": ["src/**/*"],                               
  "exclude": ["node_modules", "**/*.spec.ts"]             
}
